# Azure Key Vault (Managed Identity)
AZURE_CLIENT_ID=<managed-identity-client-id>
AZURE_KEY_VAULT_URL=https://kv-turksquare-prod-cu.vault.azure.net/
AZURE_JWT_SIGNING_KEY_NAME=turksquare-identity-jwt-signing

# Database
DATABASE_URL=postgresql://<user>:<pass>@psql-turksquare-prod-cu.postgres.database.azure.com:5432/verification?sslmode=require

# Stripe
STRIPE_SECRET_KEY=sk_test_or_live_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
VERIFICATION_RETURN_URL=https://turksquare.com/verification/callback

# Azure Service Bus
AZURE_SERVICE_BUS_CONNECTION_STRING=<service-bus-connection-string>
AZURE_VERIFICATION_CAPABILITY_QUEUE_NAME=verification-capability

# Runtime
NODE_ENV=production
PORT=8082
