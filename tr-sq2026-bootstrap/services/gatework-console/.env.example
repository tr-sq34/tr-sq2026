# Public hostname; do not use api.turksquare.com for Gatework.
GATEWORK_ORIGIN=https://gatework.turksquare.com
IDENTITY_API_BASE_URL=https://api.turksquare.com
COMMUNITY_API_BASE_URL=https://api.turksquare.com
# 32+ random bytes, stored only in AWS Secrets Manager in production.
GATEWORK_SESSION_SECRET=replace-with-32-byte-random-secret
# The first-owner bootstrap is Identity configuration, not console configuration:
# the console has no way to create an account. See
# infra/bootstrap/gatework-identity-bootstrap.md.
