# Azure Key Vault (Managed Identity)
AZURE_CLIENT_ID=<managed-identity-client-id>
AZURE_KEY_VAULT_URL=https://kv-turksquare-prod-cu.vault.azure.net/
AZURE_JWT_SIGNING_KEY_NAME=turksquare-identity-jwt-signing

# Database
DATABASE_URL=postgresql://<user>:<pass>@psql-turksquare-prod-cu.postgres.database.azure.com:5432/identity?sslmode=require

# JWT / Auth
JWT_ISSUER=https://api.turksquare.com
JWT_AUDIENCE=https://api.turksquare.com
JWT_KEY_ID=turksquare-identity-jwt-signing
EMAIL_CODE_HMAC_SECRET=<32-byte-base64-or-hex-secret>

# WebAuthn
WEBAUTHN_RP_ID=turksquare.com
WEBAUTHN_ORIGIN=https://turksquare.com

# Email
EMAIL_FROM=noreply@turksquare.com
EMAIL_RELAY_FUNCTION_NAME=https://func-email-relay-prod-cu.azurewebsites.net
EMAIL_DELIVERY_WEBHOOK=https://func-email-relay-prod-cu.azurewebsites.net/api/emailRelay

# Password safety
PASSWORD_SAFETY_FUNCTION_NAME=https://func-password-breach-check-prod-cu.azurewebsites.net
PWNED_PASSWORDS_RANGE_URL=https://func-password-breach-check-prod-cu.azurewebsites.net/api/passwordBreachCheck

# Azure Service Bus
AZURE_SERVICE_BUS_CONNECTION_STRING=<service-bus-connection-string>
AZURE_COMMUNITY_PROFILE_QUEUE_NAME=community-profile-projection

# Gatework
GATEWORK_COMMUNITY_AUDIENCE=https://community-api.turksquare.com
GATEWORK_ALLOWED_DOMAIN=turksquare.app
GATEWORK_BOOTSTRAP_OWNER_EMAIL=<owner-email>
# Only when the owner account does not exist yet. An argon2id digest, never a
# password: Identity refuses anything that does not start with $argon2id$.
# See infra/bootstrap/gatework-identity-bootstrap.md. Remove after first login.
GATEWORK_BOOTSTRAP_OWNER_PASSWORD_HASH=<argon2id-digest>
GATEWORK_BOOTSTRAP_OWNER_DISPLAY_NAME=<owner-display-name>

# Runtime
NODE_ENV=production
PORT=8080
