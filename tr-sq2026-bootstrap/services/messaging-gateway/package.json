{
  "name": "turksquare-messaging-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/server.js",
    "start:projection-worker": "node --enable-source-maps dist/projection_worker.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts"
  },
    "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-keys": "^4.10.2",
    "@azure/service-bus": "^7.9.5",
    "@fastify/cors": "11.0.0",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.1.0",
    "fastify": "5.10.0",
    "jose": "5.9.6",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
