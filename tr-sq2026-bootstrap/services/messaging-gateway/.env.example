# Azure Key Vault (Managed Identity)
AZURE_CLIENT_ID=<managed-identity-client-id>
AZURE_KEY_VAULT_URL=https://kv-turksquare-prod-cu.vault.azure.net/
AZURE_JWT_SIGNING_KEY_NAME=turksquare-identity-jwt-signing

# Database
DATABASE_URL=postgresql://<user>:<pass>@psql-turksquare-prod-cu.postgres.database.azure.com:5432/messaging?sslmode=require

# Matrix
MATRIX_BASE_URL=https://matrix-api.turksquare.com
MATRIX_APPSERVICE_TOKEN=<appservice-token>
MATRIX_SERVER_NAME=turksquare.com
INTERNAL_SERVICE_TOKEN=<internal-service-token>

# Runtime
NODE_ENV=production
PORT=8080
