# Azure Key Vault (Managed Identity)
AZURE_CLIENT_ID=<managed-identity-client-id>
AZURE_KEY_VAULT_URL=https://kv-turksquare-prod-cu.vault.azure.net/
AZURE_JWT_SIGNING_KEY_NAME=turksquare-identity-jwt-signing

# Database
DATABASE_URL=postgresql://<user>:<pass>@psql-turksquare-prod-cu.postgres.database.azure.com:5432/community?sslmode=require

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=stturksquaremediaprodcu
AZURE_STORAGE_ACCOUNT_KEY=<primary-access-key>
AZURE_MEDIA_CONTAINER_NAME=community-media

# Azure Service Bus
AZURE_SERVICE_BUS_CONNECTION_STRING=<service-bus-connection-string>
AZURE_COMMUNITY_PROFILE_QUEUE_NAME=community-profile-projection

# Optional Stripe
STRIPE_SECRET_KEY=sk_test_or_live_change_me

# Runtime
NODE_ENV=production
PORT=8080
MEDIA_PROCESSOR_POLL_MS=3000
