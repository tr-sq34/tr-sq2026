DATABASE_URL=postgres://turksquare:change-me@localhost:5432/turksquare
JWT_ISSUER=https://api.turksquare.com
JWT_AUDIENCE=turksquare-mobile
JWT_SECRET=replace-with-a-32-byte-or-longer-secret
PORT=8080
EMAIL_FROM=noreply@turksquare.com
# HTTPS universal/app-link handler that consumes the action and token query parameters.
AUTH_ACTION_BASE_URL=https://turksquare.com/auth/action
WEBAUTHN_RP_ID=turksquare.com
WEBAUTHN_ORIGIN=https://turksquare.com
# Required in production; set off only for isolated local development.
PWNED_PASSWORDS_MODE=required
# Optional approved range API mirror. Receives only 5 SHA-1 hash characters.
PWNED_PASSWORDS_RANGE_URL=https://api.pwnedpasswords.com/range
